{
    "freqai": {
        "enabled": true,
        "identifier": "candle-meta-v1",
        "purge_old_models": 2,
        "train_period_days": 540,
        "backtest_period_days": 60,
        "live_retrain_hours": 24,
        "expiration_hours": 48,
        "activate_tensorboard": false,
        "feature_parameters": {
            "include_timeframes": ["4h", "1d"],
            "include_corr_pairlist": ["BTC/USDT"],
            "label_period_candles": 30,
            "include_shifted_candles": 2,
            "indicator_periods_candles": [14, 50],
            "DI_threshold": 0,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": false
        },
        "data_split_parameters": {
            "test_size": 0.2,
            "shuffle": false
        },
        "model_training_parameters": {
            "n_estimators": 300,
            "learning_rate": 0.03,
            "num_leaves": 15,
            "min_child_samples": 50,
            "subsample": 0.8,
            "subsample_freq": 1,
            "colsample_bytree": 0.7,
            "verbosity": -1
        }
    }
}
