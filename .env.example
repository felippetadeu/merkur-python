# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NUNCA deve ir para o GitHub (ele já está no .gitignore).

# --- Telegram ---
# Token do bot criado no @BotFather
FREQTRADE__TELEGRAM__ENABLED=true
FREQTRADE__TELEGRAM__TOKEN=
# Seu chat id (pegue com o @userinfobot)
FREQTRADE__TELEGRAM__CHAT_ID=

# --- Binance ---
# Não é necessário no modo simulação (dry_run).
# Só preencha quando for operar de verdade, com uma chave SEM permissão de saque.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=
